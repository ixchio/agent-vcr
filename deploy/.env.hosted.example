# Copy these values into Railway Variables. Never commit an actual .env file.
# Railway provides PORT automatically and DATABASE_URL can reference its
# PostgreSQL service, for example: ${{Postgres.DATABASE_URL}}

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/agent_vcr
AGENT_VCR_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AGENT_VCR_SUPABASE_AUDIENCE=authenticated
AGENT_VCR_APP_URL=https://app.example.com

# Create one recurring Stripe Price for the initial Pro plan.
AGENT_VCR_STRIPE_SECRET_KEY=sk_live_REPLACE_ME
AGENT_VCR_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
AGENT_VCR_STRIPE_PRICE_ID=price_REPLACE_ME
