# Copy these values into Railway Variables. Never commit an actual .env file.
# Railway provides PORT automatically and DATABASE_URL can reference its
# PostgreSQL service, for example: ${{Postgres.DATABASE_URL}}

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/agent_vcr
AGENT_VCR_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AGENT_VCR_SUPABASE_AUDIENCE=authenticated
AGENT_VCR_APP_URL=https://app.example.com

# Create one recurring Stripe Price for the initial Pro plan.
AGENT_VCR_STRIPE_SECRET_KEY=sk_live_REPLACE_ME
AGENT_VCR_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
AGENT_VCR_STRIPE_PRICE_ID=price_REPLACE_ME

# Required: the server refuses to listen on 0.0.0.0 without a token.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_VCR_ADMIN_TOKEN is required to create projects and mint project tokens.
# AGENT_VCR_AUTH_TOKEN is optional and carries the same (admin) privileges; use it
# for the dashboard, recorders (/api/push) and /ws/live if you want a separate secret.
# Every /api route except /api/health and /api/hosted/* requires one of these
# (or, for /api/projects/<id>/..., a token minted for that project).
AGENT_VCR_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
AGENT_VCR_AUTH_TOKEN=
# Only for deliberately public, throwaway instances. Leave unset in production.
# AGENT_VCR_ALLOW_UNAUTHENTICATED=1
